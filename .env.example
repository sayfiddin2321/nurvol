DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com

# Optional absolute, persistent directory writable by the Gunicorn service user.
# MEDIA_ROOT=/var/lib/nurvolt/media
# FILE_UPLOAD_TEMP_DIR=/var/lib/nurvolt/tmp

# If TLS terminates at a trusted reverse proxy, enable this only when it
# reliably sets X-Forwarded-Proto to "https".
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=your-email@example.com

# PostgreSQL
DB_NAME=nurvolt
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
